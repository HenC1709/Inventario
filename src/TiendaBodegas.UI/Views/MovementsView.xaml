<UserControl x:Class="TiendaBodegas.UI.Views.MovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Historial de entradas y salidas de inventario"
                       VerticalAlignment="Center"
                       Style="{StaticResource PageSubtitleTextStyle}" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+ Entrada"
                        Command="{Binding RegisterEntryCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" />
                <Button Content="- Salida / Venta"
                        Command="{Binding RegisterExitCommand}"
                        Style="{StaticResource SecondaryCoolButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{StaticResource Pearl100Brush}"
                BorderBrush="{StaticResource Pearl300Brush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Desde:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                Style="{StaticResource ModernDatePickerStyle}"
                                Width="130" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Hasta:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                Style="{StaticResource ModernDatePickerStyle}"
                                Width="130" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Tipo:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,6,0" />
                    <ComboBox Width="125"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding MovementTypeFilters}"
                              SelectedItem="{Binding SelectedMovementTypeFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <Button Content="Limpiar"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryCoolButtonStyle}"
                        Padding="12,6"
                        Margin="0,2,0,2" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource StatusBannerBorderStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusBannerTextStyle}" />
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Movements}"
                  AutoGenerateColumns="False"
                  Style="{StaticResource ModernDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55" />
                <DataGridTextColumn Header="FECHA" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="135" />
                <DataGridTextColumn Header="TIPO" Binding="{Binding MovementTypeLabel}" Width="85" />
                <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="105" />
                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="210" />
                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="85" />
                <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding UnitPrice, StringFormat=C2}" Width="105" />
                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat=C2}" Width="105" />
                <DataGridTextColumn Header="OBSERVACIONES" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
