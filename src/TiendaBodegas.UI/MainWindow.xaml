<Window x:Class="TiendaBodegas.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TiendaBodegas.UI.Views"
        xmlns:vm="clr-namespace:TiendaBodegas.UI.ViewModels"
        Title="TiendaBodegas — Control de Inventario"
        Width="1050"
        Height="650"
        MinWidth="820"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WarehousesViewModel}">
            <views:WarehousesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}">
            <views:MovementsView />
        </DataTemplate>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B" Padding="16,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,28">
                    <TextBlock Text="TiendaBodegas"
                               Foreground="#FFFFFF"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Gestión de Inventario"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="Bodegas"
                            Command="{Binding ShowWarehousesCommand}"
                            Style="{StaticResource SidebarButtonStyle}" />
                    <Button Content="Productos"
                            Command="{Binding ShowProductsCommand}"
                            Style="{StaticResource SidebarButtonStyle}" />
                    <Button Content="Stock por Bodega"
                            Command="{Binding ShowStockCommand}"
                            Style="{StaticResource SidebarButtonStyle}" />
                    <Button Content="Movimientos"
                            Command="{Binding ShowMovementsCommand}"
                            Style="{StaticResource SidebarButtonStyle}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           VerticalAlignment="Bottom"
                           Text="MVP 1 · Base WPF"
                           Foreground="#64748B"
                           FontSize="11"
                           Margin="4,0,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding CurrentSectionTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       Margin="0,0,0,16" />

            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
