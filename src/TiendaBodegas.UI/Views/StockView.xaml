<UserControl x:Class="TiendaBodegas.UI.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="AlertBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="BorderBrush" Value="#86EFAC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLowStockAlerts}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertBannerTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#166534" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLowStockAlerts}" Value="True">
                    <Setter Property="Foreground" Value="#991B1B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LowStockRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="Foreground" Value="#991B1B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StockStatusCellTemplate">
            <Border CornerRadius="10"
                    Padding="8,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#DCFCE7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="11" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="OK" />
                            <Setter Property="Foreground" Value="#166534" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                    <Setter Property="Text" Value="Stock bajo" />
                                    <Setter Property="Foreground" Value="#991B1B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Bodega:"
                               VerticalAlignment="Center"
                               Foreground="#334155"
                               FontSize="13"
                               Margin="0,0,8,0" />
                    <ComboBox Width="180"
                              Padding="8,5"
                              FontSize="13"
                              ItemsSource="{Binding WarehouseFilters}"
                              SelectedItem="{Binding SelectedWarehouseFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Buscar:"
                               VerticalAlignment="Center"
                               Foreground="#334155"
                               FontSize="13"
                               Margin="0,0,8,0" />
                    <TextBox Width="210"
                             Padding="8,5"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             ToolTip="Filtrar por producto, SKU o bodega"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox Content="Solo stock bajo"
                          IsChecked="{Binding ShowOnlyLowStock, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="#334155"
                          Margin="0,2,16,2" />

                <Button Content="Limpiar"
                        Command="{Binding ClearFiltersCommand}"
                        Padding="12,6"
                        Margin="0,2,0,2"
                        Background="#FFFFFF"
                        Foreground="#334155"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Cursor="Hand" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertBannerStyle}">
            <TextBlock Text="{Binding AlertSummaryText}" Style="{StaticResource AlertBannerTextStyle}" />
        </Border>

        <TabControl Grid.Row="2" BorderBrush="#D5DCE6">
            <TabItem Header="Existencias por Bodega">
                <DataGrid ItemsSource="{Binding StockItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8FAFC"
                          RowHeight="34"
                          RowStyle="{StaticResource LowStockRowStyle}"
                          BorderBrush="#D5DCE6"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bodega" Binding="{Binding WarehouseName}" Width="170" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="110" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Stock Bodega" Binding="{Binding Quantity}" Width="110" />
                        <DataGridTextColumn Header="Stock Mín." Binding="{Binding MinStock}" Width="95" />
                        <DataGridTextColumn Header="Stock Total" Binding="{Binding TotalProductStock}" Width="105" />
                        <DataGridTemplateColumn Header="Estado"
                                                CellTemplate="{StaticResource StockStatusCellTemplate}"
                                                Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Total por Producto">
                <DataGrid ItemsSource="{Binding ProductTotals}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8FAFC"
                          RowHeight="34"
                          RowStyle="{StaticResource LowStockRowStyle}"
                          BorderBrush="#D5DCE6"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="130" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Stock Total" Binding="{Binding TotalStock}" Width="120" />
                        <DataGridTextColumn Header="Stock Mín." Binding="{Binding MinStock}" Width="110" />
                        <DataGridTemplateColumn Header="Estado"
                                                CellTemplate="{StaticResource StockStatusCellTemplate}"
                                                Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
