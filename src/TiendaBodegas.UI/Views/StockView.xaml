<UserControl x:Class="TiendaBodegas.UI.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="AlertBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLowStockAlerts}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Warm100Brush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Warm200Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertBannerTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLowStockAlerts}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warm700Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StockStatusCellTemplate">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccessBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StockStatusLabel}" Value="Bajo Stock">
                                <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StockStatusLabel}" Value="Sin Stock">
                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StockStatusLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeSuccessTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockStatusLabel}" Value="Bajo Stock">
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StockStatusLabel}" Value="Sin Stock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Pearl100Brush}"
                BorderBrush="{StaticResource Pearl300Brush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Buscar:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,8,0" />
                    <TextBox Width="250"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Tag="Filtrar por producto, SKU, categoría o proveedor..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox Content="Solo stock bajo"
                          IsChecked="{Binding ShowOnlyLowStock, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          Margin="0,2,16,2" />

                <Button Content="Limpiar"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryCoolButtonStyle}"
                        Padding="12,6"
                        Margin="0,2,0,2" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AlertBannerStyle}">
            <TextBlock Text="{Binding AlertSummaryText}" Style="{StaticResource AlertBannerTextStyle}" />
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ProductTotals}"
                  AutoGenerateColumns="False"
                  Style="{StaticResource ModernDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="110" />
                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" />
                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" Width="115" />
                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding SupplierName}" Width="190" />
                <DataGridTextColumn Header="PRECIO VENTA" Binding="{Binding SalePrice, StringFormat=C2}" Width="110" />
                <DataGridTextColumn Header="STOCK" Binding="{Binding TotalStock}" Width="80" />
                <DataGridTextColumn Header="MÍNIMO" Binding="{Binding MinStock}" Width="80" />
                <DataGridTemplateColumn Header="ESTADO"
                                        CellTemplate="{StaticResource StockStatusCellTemplate}"
                                        Width="115" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
