<Window x:Class="TiendaBodegas.UI.Views.ProductFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="pack://application:,,,/StockFlow;component/Assets/Inventory.ico"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FocusManager.FocusedElement="{Binding ElementName=SkuTextBox}">
    <Grid Margin="16">
        <Border Style="{StaticResource ModalSurfaceBorderStyle}"
                Effect="{StaticResource ModalShadowEffect}">
            <StackPanel>
                <!-- Cabecera blanca del modal -->
                <Border Style="{StaticResource ModalHeaderBorderStyle}">
                    <Grid>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button Command="{Binding CancelCommand}"
                                IsCancel="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource ModalCloseButtonStyle}"
                                ToolTip="Cerrar">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Cuerpo del formulario -->
                <StackPanel Margin="24,20,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SKU" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <TextBox x:Name="SkuTextBox"
                                     Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Tag="Ej. SKU-10482"
                                     Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="{Binding SkuError}" Style="{StaticResource FieldErrorTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CATEGORÍA" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Tag="Ej. Alimentos"
                                     Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="{Binding CategoryError}" Style="{StaticResource FieldErrorTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="NOMBRE DEL PRODUCTO" Style="{StaticResource FieldLabelTextStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Tag="Ej. Café Espresso Molido 1kg"
                             Style="{StaticResource ModernTextBoxStyle}" />
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldErrorTextStyle}" />

                    <TextBlock Text="PROVEEDOR" Style="{StaticResource FieldLabelTextStyle}" Margin="0,14,0,5" />
                    <ComboBox ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ModernComboBoxStyle}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PurchasePriceLabel}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Tag="{Binding PricePlaceholder}"
                                     Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="{Binding PurchasePriceError}" Style="{StaticResource FieldErrorTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding SalePriceLabel}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Tag="{Binding PricePlaceholder}"
                                     Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="{Binding SalePriceError}" Style="{StaticResource FieldErrorTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="STOCK ACTUAL" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Tag="0"
                                     Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="{Binding StockError}" Style="{StaticResource FieldErrorTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="STOCK MÍNIMO (UMBRAL DE ALERTA)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding MinStockText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Tag="10"
                             Style="{StaticResource ModernTextBoxStyle}" />
                    <TextBlock Text="{Binding MinStockError}" Style="{StaticResource FieldErrorTextStyle}" />

                    <Border Style="{StaticResource FormErrorBannerStyle}">
                        <TextBlock Text="{Binding FormError}"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Height="1"
                            Background="{StaticResource Pearl200Brush}"
                            Margin="0,18,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,10,0" />
                        <Button Content="Guardar Producto"
                                Command="{Binding SaveCommand}"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
