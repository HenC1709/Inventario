<UserControl x:Class="TiendaBodegas.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="980">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="HeaderSortButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Stone600Brush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Cool700Brush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventoryColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Stone600Brush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="StockStatusPillTemplate">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccessBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StockStatusLabel}" Value="Bajo Stock">
                                <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StockStatusLabel}" Value="Sin Stock">
                                <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StockStatusLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BadgeSuccessTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockStatusLabel}" Value="Bajo Stock">
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StockStatusLabel}" Value="Sin Stock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowActionsTemplate">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button ToolTip="Editar"
                        Style="{StaticResource TableIconButtonStyle}"
                        Command="{Binding DataContext.EditProductByItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Margin="0,0,6,0">
                    <Path Data="M 11.5,1.5 L 14.5,4.5 L 5,14 L 1.5,14.5 L 2,11 Z M 9.5,3.5 L 12.5,6.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14"
                          Height="14"
                          Stretch="Uniform" />
                </Button>

                <Button ToolTip="Eliminar"
                        Style="{StaticResource TableDeleteIconButtonStyle}"
                        Command="{Binding DataContext.DeleteProductByItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Path Data="M 2,4 L 14,4 M 5.5,4 L 5.5,2 L 10.5,2 L 10.5,4 M 4,4 L 4.7,13.5 L 11.3,13.5 L 12,4 M 6.7,6.5 L 6.7,11 M 9.3,6.5 L 9.3,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14"
                          Height="14"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera de Sección -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Inventario de Productos" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Control de existencias, costos y precios en tiempo real"
                           Style="{StaticResource PageSubtitleTextStyle}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource Pearl300Brush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource SuccessDotBrush}"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Sincronizado localmente"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tarjetas KPI Superiores -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,18">
            <Button Command="{Binding ResetFiltersCommand}"
                    Style="{StaticResource KpiCardButtonStyle}"
                    Margin="0,0,12,0">
                <Border Style="{StaticResource KpiPrimaryFocusCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Productos"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource Stone600Brush}" />
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{Binding TotalProductsCount}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Bottom" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource Warm50Brush}"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    Margin="0,0,0,3">
                                <TextBlock Text="Ver todos"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Warm600Brush}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>

            <Button Command="{Binding FilterLowStockCommand}"
                    Style="{StaticResource KpiCardButtonStyle}"
                    Margin="0,0,12,0">
                <Border Style="{StaticResource KpiAlertCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Bajo Stock / Agotados"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding LowAndOutOfStockCount}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Warm600Brush}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding LowStockAlertBadgeText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Warm600Brush}"
                                       VerticalAlignment="Bottom"
                                       Margin="10,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>

            <Border Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Categorías Activas"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{StaticResource Stone600Brush}" />
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding ActiveCategoriesCount}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="Registradas"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   Margin="0,0,0,4" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCardStyle}">
                <StackPanel>
                    <TextBlock Text="Valor Estimado"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{StaticResource Stone600Brush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding FormattedEstimatedValue}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="USD"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Barra de Herramientas -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="265" Margin="0,0,10,6">
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Padding="12,8,34,8"
                             Tag="Buscar por nombre, SKU o categoría..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Data="M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 Z M 9.8,9.8 L 14,14"
                          Stroke="{StaticResource TextSubtleBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          IsHitTestVisible="False" />
                </Grid>

                <ComboBox Width="165"
                          Margin="0,0,10,6"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label" />

                <ComboBox Width="150"
                          Margin="0,0,10,6"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label" />

                <ComboBox Width="185"
                          Margin="0,0,10,6"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding SupplierFilters}"
                          SelectedItem="{Binding SelectedSupplierFilter, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
            </WrapPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="8,0,0,0">
                <Button Content="+ Agregar Producto"
                        Command="{Binding CreateProductCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0" />

                <Button Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource SecondaryCoolButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 2,11 L 2,13.5 L 14,13.5 L 14,11 M 8,2 L 8,10.5 M 4.8,7.3 L 8,10.5 L 11.2,7.3"
                              Stroke="{StaticResource Cool700Brush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Margin="0,0,7,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Exportar CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Banner de Estado -->
        <Border Grid.Row="3" Style="{StaticResource StatusBannerBorderStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusBannerTextStyle}" />
        </Border>

        <!-- Tarjeta Tabla de Inventario + Paginación -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fondo redondeado para cabecera de tabla -->
                <Border Grid.Row="0"
                        Background="{StaticResource Pearl100Brush}"
                        BorderBrush="{StaticResource Pearl300Brush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="15,15,0,0"
                        Height="42"
                        VerticalAlignment="Top" />

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding PagedItems}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Pearl200Brush}"
                          HeadersVisibility="Column"
                          RowHeight="48"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          ColumnHeaderStyle="{StaticResource InventoryColumnHeaderStyle}"
                          RowStyle="{StaticResource ModernDataGridRowStyle}"
                          CellStyle="{StaticResource ModernDataGridCellStyle}">
                    <DataGrid.Columns>
                        <!-- SKU -->
                        <DataGridTextColumn Binding="{Binding ProductSku}" Width="112">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Sku">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SKU" />
                                        <TextBlock Text="{Binding DataContext.SkuSortIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- PRODUCTO -->
                        <DataGridTextColumn Binding="{Binding ProductName}" Width="*">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PRODUCTO" />
                                        <TextBlock Text="{Binding DataContext.NameSortIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- CATEGORÍA -->
                        <DataGridTextColumn Binding="{Binding Category}" Width="120">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Category">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CATEGORÍA" />
                                        <TextBlock Text="{Binding DataContext.CategorySortIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Stone600Brush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- PRECIO COMPRA -->
                        <DataGridTextColumn Binding="{Binding PurchasePrice, StringFormat='$#,##0.00'}" Width="125">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        HorizontalContentAlignment="Right"
                                        Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="PurchasePrice">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="PRECIO COMPRA" />
                                        <TextBlock Text="{Binding DataContext.PurchasePriceSortIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource Stone600Brush}" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- PRECIO VENTA -->
                        <DataGridTextColumn Binding="{Binding SalePrice, StringFormat='$#,##0.00'}" Width="120">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        HorizontalContentAlignment="Right"
                                        Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="SalePrice">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="PRECIO VENTA" />
                                        <TextBlock Text="{Binding DataContext.SalePriceSortIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- STOCK -->
                        <DataGridTextColumn Binding="{Binding TotalStock}" Width="88">
                            <DataGridTextColumn.Header>
                                <Button Style="{StaticResource HeaderSortButtonStyle}"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="Stock">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="STOCK" />
                                        <TextBlock Text="{Binding DataContext.StockSortIndicator, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource TextSubtleBrush}"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource Stone800Brush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warm600Brush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ESTADO -->
                        <DataGridTemplateColumn CellTemplate="{StaticResource StockStatusPillTemplate}" Width="115">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="ESTADO" HorizontalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>

                        <!-- ACCIONES -->
                        <DataGridTemplateColumn CellTemplate="{StaticResource RowActionsTemplate}" Width="105">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="ACCIONES" HorizontalAlignment="Center" />
                            </DataGridTemplateColumn.Header>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Estado vacío -->
                <TextBlock Grid.Row="0"
                           Text="No se encontraron productos con los filtros seleccionados."
                           Foreground="{StaticResource TextSubtleBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,42,0,0"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

                <!-- Pie de Tabla con Contador y Paginación -->
                <Border Grid.Row="1"
                        Background="{StaticResource Pearl50Brush}"
                        BorderBrush="{StaticResource Pearl200Brush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,15,15"
                        Padding="18,12">
                    <Grid>
                        <TextBlock Text="{Binding PaginationInfoText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="‹ Anterior"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource PaginationButtonStyle}"
                                    Margin="0,0,6,0" />

                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Number}"
                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Number}"
                                                Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PaginationButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Cool600Brush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Cool600Brush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource SurfaceWhiteBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Siguiente ›"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource PaginationButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
