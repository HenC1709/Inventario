<Window x:Class="TiendaBodegas.UI.Views.SupplierFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Icon="pack://application:,,,/StockFlow;component/Assets/Inventory.ico"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <Grid Margin="16">
        <Border Style="{StaticResource ModalSurfaceBorderStyle}"
                Effect="{StaticResource ModalShadowEffect}">
            <StackPanel>
                <Border Style="{StaticResource ModalHeaderBorderStyle}">
                    <Grid>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Button Command="{Binding CancelCommand}"
                                IsCancel="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource ModalCloseButtonStyle}"
                                ToolTip="Cerrar">
                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Margin="24,20,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CÓDIGO (OPCIONAL)" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Tag="Auto: PRV-XX"
                                     Style="{StaticResource ModernTextBoxStyle}" />
                            <TextBlock Text="{Binding CodeError}" Style="{StaticResource FieldErrorTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ESTADO" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                                      SelectedValuePath="Status"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource ModernComboBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="RAZÓN SOCIAL" Style="{StaticResource FieldLabelTextStyle}" Margin="0,14,0,5" />
                    <TextBox x:Name="NameTextBox"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Tag="Ej. Distribuidora del Norte S.A."
                             Style="{StaticResource ModernTextBoxStyle}" />
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldErrorTextStyle}" />

                    <TextBlock Text="CONTACTO" Style="{StaticResource FieldLabelTextStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Tag="Ej. contacto@distnorte.com"
                             Style="{StaticResource ModernTextBoxStyle}" />
                    <TextBlock Text="{Binding ContactError}" Style="{StaticResource FieldErrorTextStyle}" />

                    <TextBlock Text="CATEGORÍA PRINCIPAL" Style="{StaticResource FieldLabelTextStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding MainCategory, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Tag="Ej. Alimentos"
                             Style="{StaticResource ModernTextBoxStyle}" />
                    <TextBlock Text="{Binding MainCategoryError}" Style="{StaticResource FieldErrorTextStyle}" />

                    <Border Style="{StaticResource FormErrorBannerStyle}">
                        <TextBlock Text="{Binding FormError}"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Height="1"
                            Background="{StaticResource Pearl200Brush}"
                            Margin="0,18,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource NeutralButtonStyle}"
                                Margin="0,0,10,0" />
                        <Button Content="Guardar Proveedor"
                                Command="{Binding SaveCommand}"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
