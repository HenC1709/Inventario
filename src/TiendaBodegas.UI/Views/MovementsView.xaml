<UserControl x:Class="TiendaBodegas.UI.Views.MovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:TiendaBodegas.UI.Converters"
             xmlns:enums="clr-namespace:TiendaBodegas.Domain.Enums;assembly=TiendaBodegas.Domain"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="980">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MovementTitleConverter x:Key="MovementTitleConverter" />
        <conv:MovementSubtitleConverter x:Key="MovementSubtitleConverter" />
        <conv:CurrencyAmountConverter x:Key="CurrencyAmountConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Registro de Ventas y Salidas" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Historial reciente de movimientos de inventario"
                           Style="{StaticResource PageSubtitleTextStyle}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Registrar Entrada"
                        Command="{Binding RegisterEntryCommand}"
                        Style="{StaticResource SecondaryCoolButtonStyle}"
                        Margin="0,0,10,0" />
                <Button Content="+ Registrar Venta / Salida"
                        Command="{Binding RegisterExitCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource Pearl300Brush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Desde:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                Style="{StaticResource ModernDatePickerStyle}"
                                Width="130" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Hasta:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                Style="{StaticResource ModernDatePickerStyle}"
                                Width="130" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Tipo:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13"
                               Margin="0,0,6,0" />
                    <ComboBox Width="140"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{Binding MovementTypeFilters}"
                              SelectedItem="{Binding SelectedMovementTypeFilter, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                </StackPanel>

                <Button Content="Limpiar"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryCoolButtonStyle}"
                        Padding="12,6"
                        Margin="0,2,0,2" />
            </WrapPanel>
        </Border>

        <!-- Banner de estado -->
        <Border Grid.Row="2" Style="{StaticResource StatusBannerBorderStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusBannerTextStyle}" />
        </Border>

        <!-- Tarjeta con filas limpias -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Movements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Pearl200Brush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="24,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Converter={StaticResource MovementTitleConverter}}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Converter={StaticResource MovementSubtitleConverter}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="16,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource CurrencyAmountConverter}">
                                                    <Binding Path="TotalAmount" />
                                                    <Binding Path="DataContext.CurrencyCode" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MovementType}" Value="{x:Static enums:MovementType.Entry}">
                                                            <Setter Property="Foreground" Value="{StaticResource Cool600Brush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="2"
                                                Content="Imprimir"
                                                ToolTip="Imprimir ticket térmico 80 mm"
                                                Command="{Binding DataContext.PrintMovementTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryCoolButtonStyle}"
                                                Padding="10,5"
                                                FontSize="12"
                                                VerticalAlignment="Center"
                                                Margin="14,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No hay movimientos registrados con los filtros seleccionados."
                           Foreground="{StaticResource TextSubtleBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNoMovements, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
