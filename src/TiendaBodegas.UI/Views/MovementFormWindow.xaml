<Window x:Class="TiendaBodegas.UI.Views.MovementFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormErrorBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding FormError}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,0,0,16" />

        <TextBlock Text="Tipo de movimiento *" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding MovementTypes}"
                  SelectedValue="{Binding SelectedMovementType, Mode=TwoWay}"
                  SelectedValuePath="Type"
                  DisplayMemberPath="Label"
                  Style="{StaticResource FormComboBoxStyle}" />

        <TextBlock Text="Producto *" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,12,0,4" />
        <ComboBox ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                  Style="{StaticResource FormComboBoxStyle}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding SKU, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" — " />
                        <Run Text="{Binding Name, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding ProductError}" Style="{StaticResource ErrorTextStyle}" />

        <StackPanel Visibility="{Binding RequiresSourceWarehouse, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,12,0,0">
            <TextBlock Text="Bodega de origen *" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Warehouses}"
                      SelectedItem="{Binding SelectedSourceWarehouse, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource FormComboBoxStyle}" />
            <TextBlock Text="{Binding SourceWarehouseError}" Style="{StaticResource ErrorTextStyle}" />
            <Border Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,6,0,0"
                    Visibility="{Binding ShowAvailableStock, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="12" Foreground="#334155">
                    <Run Text="Stock disponible en bodega origen: " />
                    <Run Text="{Binding AvailableSourceStock, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </Border>
        </StackPanel>

        <StackPanel Visibility="{Binding RequiresDestinationWarehouse, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,12,0,0">
            <TextBlock Text="Bodega de destino *" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Warehouses}"
                      SelectedItem="{Binding SelectedDestinationWarehouse, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                      DisplayMemberPath="Name"
                      Style="{StaticResource FormComboBoxStyle}" />
            <TextBlock Text="{Binding DestinationWarehouseError}" Style="{StaticResource ErrorTextStyle}" />
        </StackPanel>

        <TextBlock Text="Cantidad *" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,12,0,4" />
        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Style="{StaticResource FormInputStyle}" />
        <TextBlock Text="{Binding QuantityError}" Style="{StaticResource ErrorTextStyle}" />

        <TextBlock Text="Observaciones" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,12,0,4" />
        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FormInputStyle}" />

        <Border Style="{StaticResource FormErrorBannerStyle}">
            <TextBlock Text="{Binding FormError}"
                       Foreground="#991B1B"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    Padding="16,8"
                    Margin="0,0,10,0"
                    Background="#F1F5F9"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Cursor="Hand" />
            <Button Content="Registrar"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Padding="18,8"
                    Background="#2563EB"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand" />
        </StackPanel>
    </StackPanel>
</Window>
