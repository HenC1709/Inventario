<UserControl x:Class="TiendaBodegas.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="980">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding Subtitle}"
                       Style="{StaticResource PageSubtitleTextStyle}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Tarjetas de Acción -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="24"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="REPORTE MENSUAL"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Warm600Brush}" />
                        <TextBlock Text="Valoración de Inventario"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,6,0,6" />
                        <TextBlock Text="Detalle de costos de compra vs. precio de venta por categoría."
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,18,0,0">
                        <Button Content="Descargar CSV"
                                Command="{Binding ExportValuationCsvCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0" />
                        <Button Content="Descargar PDF"
                                Command="{Binding ExportValuationPdfCommand}"
                                Style="{StaticResource SecondaryCoolButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="24"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="AUDITORÍA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Warm600Brush}" />
                        <TextBlock Text="Productos con Rotación Baja"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,6,0,6" />
                        <TextBlock Text="Listado de SKU sin movimientos en los últimos 30 días."
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Row="1"
                            Content="Generar Reporte"
                            Command="{Binding GenerateLowRotationReportCommand}"
                            Style="{StaticResource SecondaryCoolButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,18,0,0" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Banner de estado -->
        <Border Grid.Row="2" Style="{StaticResource StatusBannerBorderStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusBannerTextStyle}" />
        </Border>

        <!-- Vista previa de auditoría de rotación baja -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                Visibility="{Binding HasGeneratedAudit, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Pearl50Brush}"
                        BorderBrush="{StaticResource Pearl200Brush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="15,15,0,0"
                        Padding="20,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Auditoría: Productos con Rotación Baja (30 días)"
                                       Style="{StaticResource SectionHeadingTextStyle}" />
                            <TextBlock Text="{Binding AuditSummaryText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Exportar Auditoría CSV"
                                    Command="{Binding ExportLowRotationCsvCommand}"
                                    Style="{StaticResource SecondaryCoolButtonStyle}"
                                    Margin="0,0,8,0" />
                            <Button Content="Exportar PDF"
                                    Command="{Binding ExportLowRotationPdfCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LowRotationItems}"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          BorderThickness="0"
                          Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding ProductSku}" Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" Width="125" />
                        <DataGridTextColumn Header="STOCK ACTUAL" Binding="{Binding CurrentStock}" Width="110" />
                        <DataGridTextColumn Header="ÚLTIMO MOVIMIENTO"
                                            Binding="{Binding LastMovementDate, StringFormat='dd/MM/yyyy HH:mm', TargetNullValue='Sin movimientos'}"
                                            Width="155" />
                        <DataGridTextColumn Header="DÍAS SIN ROTACIÓN"
                                            Binding="{Binding DaysWithoutMovement, TargetNullValue='—'}"
                                            Width="135" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1"
                           Text="Todos los productos presentan movimientos recientes en los últimos 30 días."
                           Foreground="{StaticResource TextSubtleBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,36,0,0"
                           Visibility="{Binding HasNoLowRotationItems, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
