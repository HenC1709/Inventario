<Window x:Class="TiendaBodegas.UI.Views.ProductFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Pearl50Brush}"
        FocusManager.FocusedElement="{Binding ElementName=NameTextBox}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SKU *" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Tag="Ej. SKU-10482"
                         Style="{StaticResource ModernTextBoxStyle}" />
                <TextBlock Text="{Binding SkuError}" Style="{StaticResource FieldErrorTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="CATEGORÍA *" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Tag="Ej. Alimentos"
                         Style="{StaticResource ModernTextBoxStyle}" />
                <TextBlock Text="{Binding CategoryError}" Style="{StaticResource FieldErrorTextStyle}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="NOMBRE DEL PRODUCTO *" Style="{StaticResource FieldLabelTextStyle}" Margin="0,12,0,4" />
        <TextBox x:Name="NameTextBox"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Tag="Ej. Café Espresso Molido 1kg"
                 Style="{StaticResource ModernTextBoxStyle}" />
        <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldErrorTextStyle}" />

        <TextBlock Text="PROVEEDOR" Style="{StaticResource FieldLabelTextStyle}" Margin="0,12,0,4" />
        <ComboBox ItemsSource="{Binding Suppliers}"
                  SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Style="{StaticResource ModernComboBoxStyle}" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="PRECIO COMPRA *" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource ModernTextBoxStyle}" />
                <TextBlock Text="{Binding PurchasePriceError}" Style="{StaticResource FieldErrorTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="PRECIO VENTA *" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource ModernTextBoxStyle}" />
                <TextBlock Text="{Binding SalePriceError}" Style="{StaticResource FieldErrorTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="STOCK MÍNIMO *" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding MinStockText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Style="{StaticResource ModernTextBoxStyle}" />
                <TextBlock Text="{Binding MinStockError}" Style="{StaticResource FieldErrorTextStyle}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding FormError}"
                   Margin="0,12,0,0"
                   Style="{StaticResource FieldErrorTextStyle}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource NeutralButtonStyle}"
                    Margin="0,0,10,0" />
            <Button Content="Guardar Producto"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
