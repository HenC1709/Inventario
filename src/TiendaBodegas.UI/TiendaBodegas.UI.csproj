    <Product>StockFlow</Product>
    <AssemblyTitle>StockFlow</AssemblyTitle>
    <Description>Sistema de gestión de inventario, proveedores, ventas y reportes.</Description>
    <ApplicationIcon>..\..\assets\Inventory.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\Inventory.ico" Link="Assets\Inventory.ico" />
  </ItemGroup>

</Project>
