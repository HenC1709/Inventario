<Window x:Class="TiendaBodegas.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TiendaBodegas.UI.Views"
        xmlns:vm="clr-namespace:TiendaBodegas.UI.ViewModels"
        Title="TiendaBodegas — Control de Inventario"
        Width="1120"
        Height="700"
        MinWidth="860"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}">
            <views:MovementsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}"
                BorderBrush="{StaticResource Pearl300Brush}"
                BorderThickness="0,0,1,0"
                Padding="14,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,24">
                    <TextBlock Text="TiendaBodegas"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Gestión de Inventario"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="PROVEEDORES"
                            Command="{Binding ShowSuppliersCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button Content="PRODUCTOS"
                            Command="{Binding ShowProductsCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button Content="STOCK"
                            Command="{Binding ShowStockCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                    <Button Content="MOVIMIENTOS"
                            Command="{Binding ShowMovementsCommand}"
                            Style="{StaticResource SidebarNavButtonStyle}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           VerticalAlignment="Bottom"
                           Text="Sistema de Inventario v1.4"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="6,0,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding CurrentSectionTitle}"
                       Style="{StaticResource PageTitleTextStyle}"
                       Margin="0,0,0,16" />

            <Border Grid.Row="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="20">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
