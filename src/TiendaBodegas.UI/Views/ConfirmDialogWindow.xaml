<Window x:Class="TiendaBodegas.UI.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="410"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Grid Margin="16">
        <Border Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource Pearl300Brush}"
                BorderThickness="1"
                CornerRadius="16"
                Effect="{StaticResource ModalShadowEffect}"
                Padding="24">
            <StackPanel>
                <Border Width="48"
                        Height="48"
                        CornerRadius="24"
                        Background="{StaticResource Warm100Brush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Path Data="M 2,4 L 14,4 M 5.5,4 L 5.5,2 L 10.5,2 L 10.5,4 M 4,4 L 4.7,13.5 L 11.3,13.5 L 12,4 M 6.7,6.5 L 6.7,11 M 9.3,6.5 L 9.3,11"
                          Stroke="{StaticResource Warm600Brush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="TitleText"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="MessageText"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,20" />

                <UniformGrid Columns="2">
                    <Button Content="Cancelar"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Style="{StaticResource NeutralButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button Content="Eliminar"
                            IsDefault="True"
                            Click="ConfirmButton_Click"
                            Style="{StaticResource ConfirmDeleteButtonStyle}"
                            Margin="6,0,0,0" />
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
